    "Can the widgets refresh more frequently?": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunnen de widgets vaker worden vernieuwd?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Могут ли виджеты обновляться чаще?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Widget'lar daha sık yenilenebilir mi?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чи можуть віджети оновлюватися частіше?"
