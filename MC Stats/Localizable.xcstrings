    "Can you add push notification/server analytics to the app?": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun je pushmeldingen/serveranalyses toevoegen aan de app?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можете добавить в приложение push-уведомления или аналитику сервера?"
