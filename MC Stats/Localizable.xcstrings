    "Check online status for ${serverType} server at ${serverAddress} and port ${serverPort}" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحقق من حالة الاتصال لخادم ${serverType} على العنوان ${serverAddress} والمنفذ ${serverPort}"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Online-Status des ${serverType}-Servers unter ${serverAddress} an Port ${serverPort} prüfen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifier l’état en ligne du serveur ${serverType} à l’adresse ${serverAddress} et au port ${serverPort}"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "${serverAddress} पते और ${serverPort} पोर्ट पर ${serverType} सर्वर की ऑनलाइन स्थिति जाँचें"
          }
        },
        "it" : {
          "stringUnit" : {
