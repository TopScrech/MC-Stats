        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чи можете ви додати до застосунку push-сповіщення або аналітику сервера?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Könnt ihr Push-Benachrichtigungen oder Server-Analysen zur App hinzufügen?"
