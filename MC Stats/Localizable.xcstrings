    "Displays the max player count alongside the current number of players in the widgets" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض الحد الأقصى لعدد اللاعبين بجانب عددهم الحالي في الأدوات"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt in den Widgets die maximale Spielerzahl neben der aktuellen Spielerzahl an"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche dans les widgets le nombre maximal de joueurs à côté du nombre actuel"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "विजेट में खिलाड़ियों की वर्तमान संख्या के साथ उनकी अधिकतम संख्या दिखाता है"
          }
        },
        "it" : {
