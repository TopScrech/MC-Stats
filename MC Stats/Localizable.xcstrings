    "If you love the app, consider leaving a review to help support development!": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je de app geweldig vindt, overweeg dan een review achter te laten om de ontwikkeling te ondersteunen"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если вам нравится приложение, подумайте о том, чтобы оставить отзыв и поддержать разработку"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamayı seviyorsanız geliştirmeyi desteklemek için değerlendirme bırakmayı düşünün!"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо вам подобається застосунок, залиште відгук, щоб підтримати його розвиток!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn dir die App gefällt, ziehe bitte eine Bewertung in Betracht, um die Entwicklung zu unterstützen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous aimez l’app, pensez à laisser un avis pour soutenir son développement"
          }
        }
      }
    },
