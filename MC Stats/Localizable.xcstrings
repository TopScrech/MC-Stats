    "Displays the max player count alongside the current number of players in the widgets": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont het maximale aantal spelers naast het huidige aantal spelers in de widgets"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает максимальное число игроков рядом с текущим количеством игроков в виджетах"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Widget'larda mevcut oyuncu sayısının yanında maksimum oyuncu sayısını gösterir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує у віджетах максимальну кількість гравців поруч із поточною кількістю"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt in den Widgets die maximale Spielerzahl neben der aktuellen Spielerzahl an"
          }
        },
        "fr": {
