    "**Hold and drag** over the chart to view and move the lollipop": {
      "extractionState": "stale",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Houd en sleep** over de grafiek om de lollipop te bekijken en te verplaatsen"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**Удерживайте и ведите** по графику, чтобы посмотреть и перемещать леденец"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Grafik üzerinde **basılı tutup sürükleyerek** lollipop'u görüntüleyin ve taşıyın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "**Натисніть і перетягніть** по графіку, щоб переглянути та перемістити льодяник"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten und ziehen Sie über das Diagramm, um den Lollipop anzuzeigen und zu verschieben"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Maintenez et faites glisser** sur le graphique pour afficher et déplacer le lollipop"
          }
        }
      }
    },
