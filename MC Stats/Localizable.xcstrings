          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is %2$@ met %3$lld spelers."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@, игроков: %3$lld."
