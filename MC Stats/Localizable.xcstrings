    "Minecraft Server domains/ip addresses must be the root domain, and not contain any '/' or ':'": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Minecraft-serverdomeinen/IP-adressen moeten het hoofddomein zijn en mogen geen '/' of ':' bevatten"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Домены/IP-адреса Minecraft-серверов должны быть корневым доменом и не должны содержать '/' или ':'"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Minecraft sunucu alan adları/IP adresleri kök alan adı olmalı ve '/' veya ':' içermemelidir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Домени або IP-адреси серверів Minecraft мають бути кореневим доменом і не повинні містити '/' або ':'"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Minecraft-Server-Domains/IP-Adressen müssen die Root-Domain sein und dürfen kein '/' oder ':' enthalten"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les domaines/adresses IP des serveurs Minecraft doivent être le domaine racine et ne pas contenir '/' ni ':'"
          }
        }
      }
    },
