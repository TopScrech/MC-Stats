            "value": "Toon spelers in elke rij onder de voortgangsbalk in de hoofdserverlijst"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать игроков в каждой строке под индикатором выполнения в основном списке серверов"
          }
        }
      }
    },
    "Show players on server list": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показать игроков в списке серверов"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toon spelers in serverlijst"
          }
        }
      }
    },
    "Show players sorted alphabetically instead of randomly": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toon spelers alfabetisch gesorteerd in plaats van willekeurig"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать игроков в алфавитном порядке, а не случайно"
          }
        }
      }
    },
    "Siri": {
      "shouldTranslate": false,
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri"
          }
        }
      }
    },
    "Some servers use plugins to disable this feature or replace player names with custom messages. Servers running versions older than 1.7 must set enable-query=true in server.properties to enable it. Additionally, Bedrock servers do not support player lists": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommige servers gebruiken plugins om deze functie uit te schakelen of spelersnamen te vervangen door aangepaste berichten. Servers met versies ouder dan 1.7 moeten enable-query=true instellen in server.properties om dit in te schakelen. Daarnaast ondersteunen Bedrock-servers geen spelerslijsten"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые серверы используют плагины, чтобы отключить эту функцию или заменить имена игроков пользовательскими сообщениями. Серверы с версиями старше 1.7 должны установить enable-query=true в server.properties, чтобы включить её. Кроме того, серверы Bedrock не поддерживают списки игроков"
          }
        }
      }
    },
    "Sort players alphabetically": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сортировать игроков в алфавитном порядке"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorteer spelers alfabetisch"
          }
        }
      }
    },
    "Source Code": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Source Code"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исходный код"
          }
        }
      }
    },
    "Start monitoring a server": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начать мониторинг сервера"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin met het volgen van een server"
          }
        }
      }
    },
    "status": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "status"
          }
        },
        "ru": {
          "stringUnit": {
