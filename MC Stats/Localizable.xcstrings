    "Check server status for ${serverEntity}": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer serverstatus van ${serverEntity}"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте статус сервера ${serverEntity}"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "${serverEntity} için sunucu durumunu kontrol et"
          }
        },
        "uk": {
          "stringUnit": {
