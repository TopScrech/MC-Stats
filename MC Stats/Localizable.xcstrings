    "All bug reports and feature requests can be raised as an issue on the [GitHub repository](https://github.com/TopScrech/MC-Stats)": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отчёты об ошибках и запросы на новые фичи можно создать в разделе Issues на [GitHub](https://github.com/TopScrech/MC-Stats)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle bugrapporten en functieverzoeken kunnen worden ingediend als issue op de [GitHub-repository](https://github.com/TopScrech/MC-Stats)"
          }
        }
      }
