    "MC Stats is used for checking the status an existing server. It will not create, setup, or host a new server" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُستخدم MC Stats للتحقق من حالة خادم موجود، ولا ينشئ خادمًا جديدًا أو يُعدّه أو يستضيفه"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MC Stats dient zum Prüfen des Status eines bestehenden Servers. Es erstellt, richtet oder hostet keinen neuen Server"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MC Stats sert à vérifier l’état d’un serveur existant. L’app ne crée pas, ne configure pas et n’héberge pas de nouveau serveur"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MC Stats का उपयोग मौजूदा सर्वर की स्थिति जाँचने के लिए किया जाता है। यह नया सर्वर बनाता, सेट अप या होस्ट नहीं करता"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MC Stats serve a controllare lo stato di un server esistente. Non crea, configura né ospita nuovi server"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MC Stats wordt gebruikt om de status van een bestaande server te controleren. Het zal geen nieuwe server maken, instellen of hosten"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MC Stats используется для проверки состояния существующего сервера. Приложение не создаёт, не настраивает и не размещает новый сервер"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MC Stats mevcut bir sunucunun durumunu kontrol etmek için kullanılır. Yeni bir sunucu oluşturmaz, kurmaz veya barındırmaz"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MC Stats використовується для перевірки стану наявного сервера. Він не створює, не налаштовує і не хостить новий сервер"
          }
        }
      }
    },
