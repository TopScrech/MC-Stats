    "NSLocalNetworkUsageDescription": {
      "comment": "Privacy - Local Network Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "This app requires local network access in order to check the status of servers on your local connection"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это приложение требует доступ к локальной сети, чтобы проверить состояние LAN-серверов"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze app heeft toegang tot het lokale netwerk nodig om de status van servers op je lokale verbinding te controleren"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulama, yerel ağınızdaki sunucuların durumunu kontrol etmek için yerel ağ erişimi gerektirir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цій програмі потрібен доступ до локальної мережі, щоб перевіряти стан серверів у вашому локальному підключенні"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App benötigt Zugriff auf das lokale Netzwerk, um den Status von Servern in Ihrem lokalen Netzwerk zu prüfen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette app a besoin d’un accès au réseau local pour vérifier l’état des serveurs sur votre connexion locale"
          }
        }
      }
    },
